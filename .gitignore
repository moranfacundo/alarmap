# dependencies
node_modules/

# Expo
.expo/
dist/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Generated by @ng-native/tailwind's withTailwind, rebuilt on every Metro start
.angular-native/

# AlarMap: documento de requisitos original (no se publica) y artefactos locales
app.md
*.log
metro.log
.claude/settings.local.json

# Artefactos de build de módulos locales
modules/*/android/build/

# Documentación local de publicación en Google Play (no se versiona)
/play-store/
